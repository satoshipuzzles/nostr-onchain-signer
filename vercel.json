{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:*; frame-src https:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/nostr.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=60"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/lnurlp/:name",
      "destination": "https://puzzl35.com/lnrelay/pay.php?p=:name&d=nostronchain.com"
    },
    {
      "source": "/.well-known/lnurlp/:name/callback",
      "destination": "https://puzzl35.com/lnrelay/pay.php?p=:name/callback&d=nostronchain.com"
    },
    {
      "source": "/.well-known/nostr.json",
      "destination": "https://nostr-onchain-eight.vercel.app/.well-known/nostr.json"
    },
    {
      "source": "/api/nip05/:path*",
      "destination": "https://nostr-onchain-eight.vercel.app/api/nip05/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/store",
      "destination": "https://pocketsigner.com/store",
      "permanent": false
    },
    {
      "source": "/nip05",
      "destination": "https://pocketsigner.com/nip05",
      "permanent": false
    },
    {
      "source": "/pocket-signer",
      "destination": "https://pocketsigner.com/pocket-signer",
      "permanent": false
    },
    {
      "source": "/signer-link",
      "destination": "https://pocketsigner.com/signer-link",
      "permanent": false
    },
    {
      "source": "/nostrtx",
      "destination": "https://nostrtx.com/",
      "permanent": false
    },
    {
      "source": "/signer",
      "destination": "https://archive.nostronchain.com/signer",
      "permanent": false
    },
    {
      "source": "/extension",
      "destination": "https://archive.nostronchain.com/extension",
      "permanent": false
    },
    {
      "source": "/extensions",
      "destination": "https://archive.nostronchain.com/extension",
      "permanent": false
    },
    {
      "source": "/keys",
      "destination": "https://archive.nostronchain.com/keys",
      "permanent": false
    }
  ]
}
